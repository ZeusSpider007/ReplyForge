# Ollama daemon address
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use. Must be installed via `ollama pull <model>`.
# Recommended on M4: llama3.1:8b, qwen2.5:7b, mistral:7b
MODEL=llama3.1:8b

# Per-request timeout to Ollama (seconds)
OLLAMA_TIMEOUT=60

# Generation knobs
TEMPERATURE=0.85
TOP_P=0.9

# Web server bind
HOST=127.0.0.1
PORT=8000
